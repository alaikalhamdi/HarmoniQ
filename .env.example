# Nebius Token Factory (OpenAI-Compatible Inference Endpoint)
NEBIUS_API_KEY="your_nebius_token_factory_key"
NEBIUS_BASE_URL="https://api.tokenfactory.nebius.com/v1"

# Nebius Serverless Jobs / Cloud Project ID (Required to dispatch remote policy verification)
NEBIUS_PROJECT_ID="your_nebius_project_id"

# Nebius Serverless AI job dispatch for the policy verifier (optional).
# When NEBIUS_VERIFIER_REMOTE="true" and the fields below are set, /api/simulate submits
# the jobs/policy-verifier container as a real Serverless AI job and uses its terminal
# state as the safety gate. Otherwise it runs that same verifier locally (python subprocess)
# and falls back to the in-process TypeScript engine if Python is unavailable.
NEBIUS_VERIFIER_REMOTE="false"
NEBIUS_IAM_TOKEN=""            # access token from: nebius iam get-access-token
NEBIUS_JOB_IMAGE=""           # registry/path:tag of the pushed verifier image
NEBIUS_JOB_PLATFORM=""        # Serverless AI platform ID (see Nebius compute types)
NEBIUS_JOB_PRESET=""          # preset that matches the chosen platform
# NEBIUS_JOB_SUBNET_ID=""
# NEBIUS_CLOUD_API_URL="https://api.nebius.cloud"
# NEBIUS_JOB_DISK_BYTES="21474836480"
# NEBIUS_JOB_POLL_BUDGET_MS="8000"
# NEBIUS_JOB_POLL_INTERVAL_MS="1500"

# Nebius Model Overrides (Optional: auto-discovery resolves best available slugs if left blank)
# NEBIUS_TIER1_MODEL="nvidia/Llama-3_1-Nemotron-Nano-8B-v1"
# NEBIUS_TIER2_MODEL="nvidia/Nemotron-3-Ultra-550b-a55b"

# Tavily Search API (Required for live hardware datasheet grounding)
TAVILY_API_KEY="tvly-your_tavily_api_key"

# Supabase Realtime Telemetry & Audit Logging (Optional: runs in-memory if unconfigured)
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your_supabase_anon_key"
