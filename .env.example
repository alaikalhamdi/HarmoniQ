# Nebius Token Factory (OpenAI-Compatible Inference Endpoint)
NEBIUS_API_KEY="your_nebius_token_factory_key"
NEBIUS_BASE_URL="https://api.tokenfactory.nebius.com/v1"

# Nebius Serverless Jobs / Cloud Project ID (Optional for remote verification jobs)
NEBIUS_PROJECT_ID="your_nebius_project_id"

# Nebius Model Overrides (Optional: auto-discovery resolves best available slugs if left blank)
# NEBIUS_TIER1_MODEL="nvidia/Llama-3_1-Nemotron-Nano-8B-v1"
# NEBIUS_TIER2_MODEL="nvidia/Nemotron-3-Ultra-550b-a55b"

# Tavily Search API (Required for live hardware datasheet grounding and $3,000 sponsor prize)
TAVILY_API_KEY="tvly-your_tavily_api_key"

# Supabase Realtime Telemetry & Audit Logging (Optional: runs in-memory if unconfigured)
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your_supabase_anon_key"
